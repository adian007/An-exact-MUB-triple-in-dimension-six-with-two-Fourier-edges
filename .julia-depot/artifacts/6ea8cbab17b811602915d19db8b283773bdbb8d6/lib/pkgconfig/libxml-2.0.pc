prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
modules=1

Name: libXML
Version: 2.15.3
Description: libXML library version2.
Requires.private: 
Libs: -L${libdir} -lxml2 
Libs.private:    -L/workspace/destdir/lib -lz -L/workspace/destdir/lib -liconv -lbcrypt -lm 
Cflags: -I${includedir}/libxml2 
Cflags.private: -DLIBXML_STATIC
