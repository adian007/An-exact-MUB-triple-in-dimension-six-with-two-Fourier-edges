{
  "latex-workshop.latex.rootFile": "paper/mub6_karlsson_ieee.tex",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.option.useFileDir": true,
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex (paper) ×2",
      "tools": ["pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%OUTDIR%",
        "%DOCFILE%"
      ]
    }
  ]
}
