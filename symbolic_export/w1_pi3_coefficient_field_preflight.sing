// Exact coefficient-algebra preflight for the pi/3 W1 candidate.
// Singular's algebraic coefficient field is K=QQ(q), Phi_36(q)=0.
ring r=(0,q),(a,b,c),dp;
minpoly=q^12-q^6+1;

poly P_a = 104329*a^24 - 193800*a^22 + 192924*a^20 - 299406*a^18
  + 331452*a^16 - 381612*a^14 + 493595*a^12 - 381612*a^10
  + 331452*a^8 - 299406*a^6 + 192924*a^4 - 193800*a^2 + 104329;
poly L_a = 1514595399406991554715184449*a^22
  - 1756307929240743070046703434*a^20
  + 989839703306762314045034317*a^18
  - 2568263831168312266729485648*a^16
  + 1531431372534934342773255463*a^14
  - 2644550445045953692323054841*a^12
  + 3958308486166522559203865220*a^10
  - 1177917192554426766591014887*a^8
  + 2139096543575902440554317075*a^6
  - 1591397118696353756136381769*a^4
  + 801861270977657426086402045*a^2
  + 610818468996621564036607682*q - 1811714204362686491473791534;
poly P_b = subst(P_a,a,b);
poly L_b = 3352989164513563728488605330*b^22
  - 2770857433192841326203024039*b^20
  + 3167065685867132714755475197*b^18
  - 6270773258597842323743219399*b^16
  + 4579744692264779374914258781*b^14
  - 8051612621828886127519440680*b^12
  + 7416627722299525522595911037*b^10
  - 4176525922160551925590943297*b^8
  + 6180409088066584397938320628*b^6
  - 2947627835384158355404461405*b^4
  + 3079541734716012913628182138*b^2
  + 610818468996621564036607682*q - 2942616298328776548850611985;
poly P_c = subst(P_a,a,c);
poly L_c = -4867584563920555283203789779*c^22
  + 4527165362433584396249727473*c^20
  - 4156905389173895028800509514*c^18
  + 8839037089766154590472705047*c^16
  - 6111176064799713717687514244*c^14
  + 10696163066874839819842495521*c^12
  - 11374936208466048081799776257*c^10
  + 5354443114714978692181958184*c^8
  - 8319505631642486838492637703*c^6
  + 4539024954080512111540843174*c^4
  - 3881403005693670339714584183*c^2
  + 610818468996621564036607682*q + 4754330502691463040324403519;

print("gcd(a,P(a)) = " + string(gcd(a,P_a)));
poly gA=gcd(P_a,L_a);
poly gB=gcd(P_b,L_b);
poly gC=gcd(P_c,L_c);
print("phase gcd degrees = " + string(deg(gA)) + ", " + string(deg(gB)) + ", " + string(deg(gC)));
print("factorization gA:"); factorize(gA);
print("factorization gB:"); factorize(gB);
print("factorization gC:"); factorize(gC);

ideal I=gA,gB,gC;
ideal G=std(I);
print("joint ideal dimension = " + string(dim(G)));
print("joint ideal vector-space dimension = " + string(vdim(G)));
LIB "primdec.lib";
list D=primdecGTZ(G);
print("number of primary components = " + string(size(D)));
for (int i=1; i<=size(D); i++)
{
  print("associated prime component " + string(i) + ":");
  print(D[i][2]);
}
quit;
