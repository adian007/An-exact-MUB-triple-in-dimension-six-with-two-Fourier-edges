  1 + z2_1 * w5_1 + z2_2 * w5_2 + z2_3 * w5_3 + z2_4 * w5_4 + z2_5 * w5_5,
  1 + z3_1 * w4_1 + z3_2 * w4_2 + z3_3 * w4_3 + z3_4 * w4_4 + z3_5 * w4_5,
  1 + z3_1 * w5_1 + z3_2 * w5_2 + z3_3 * w5_3 + z3_4 * w5_4 + z3_5 * w5_5,
  1 + z4_1 * w5_1 + z4_2 * w5_2 + z4_3 * w5_3 + z4_4 * w5_4 + z4_5 * w5_5
);
